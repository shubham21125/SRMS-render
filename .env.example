# ── Django Settings ──────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=generate-a-secure-random-key-here
CSRF_TRUSTED_ORIGINS=http://yourdomain.com,https://yourdomain.com

# ── Database Configurations ──────────────────────────────────────────────────
# Default values for local dev (fallback SQLite is used if DB_NAME is empty)
DB_NAME=srms_db
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Caching Backend (Redis) ──────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ── Production SMTP Email Configurations ──────────────────────────────────────
# Required in production; missing EMAIL_HOST_USER causes crash on startup
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=notifications@yourdomain.com

# ── Google OAuth2 Login Configurations ────────────────────────────────────────
# Required for Google single sign-on authentication
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:8000/admin-google-callback/
GOOGLE_ADMIN_ALLOWED_EMAILS=admin1@yourdomain.com,admin2@yourdomain.com

# ── Gemini AI Configurations (Chatbot) ───────────────────────────────────────
GEMINI_API_KEY=your-gemini-ai-api-key

# ── Meta WhatsApp Cloud API Configurations ────────────────────────────────────
WHATSAPP_TOKEN=your-meta-whatsapp-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-id
